generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Phoneme {
  id      Int    @id @default(autoincrement())
  symbol  String @unique
  letters String
  example String

  words WordPhoneme[]
}

model WordList {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  words      Word[]
  activities Activity[]
}

model Word {
  id        Int      @id @default(autoincrement())
  english   String
  listId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list     WordList      @relation(fields: [listId], references: [id], onDelete: Cascade)
  phonemes WordPhoneme[]
  targetOf Activity[]

  @@unique([listId, english])
}

// one row per sound so something like tʃ stays as one sound
model WordPhoneme {
  id        Int @id @default(autoincrement())
  wordId    Int
  phonemeId Int
  position  Int

  word    Word    @relation(fields: [wordId], references: [id], onDelete: Cascade)
  phoneme Phoneme @relation(fields: [phonemeId], references: [id])

  @@unique([wordId, position])
}

model Activity {
  id           Int          @id @default(autoincrement())
  name         String
  type         ActivityType
  maxGuesses   Int          @default(6)
  gridSize     Int          @default(10)
  showLetters  Boolean      @default(true)
  showEnglish  Boolean      @default(true)
  listId       Int
  targetWordId Int?
  simulated    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  list       WordList        @relation(fields: [listId], references: [id], onDelete: Cascade)
  targetWord Word?           @relation(fields: [targetWordId], references: [id], onDelete: SetNull)
  logs       GenerationLog[]
}

// one row every time Generate is pressed, whether it worked or not
model GenerationLog {
  id         Int          @id @default(autoincrement())
  activityId Int?
  type       ActivityType
  success    Boolean
  message    String?
  simulated  Boolean      @default(false)
  createdAt  DateTime     @default(now())

  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
}

// how long someone stayed on a page
model PageVisit {
  id        Int      @id @default(autoincrement())
  page      String
  seconds   Int
  simulated Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum ActivityType {
  wordle
  wordsearch
}
